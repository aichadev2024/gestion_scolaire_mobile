**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Le build web n'est plus versionné : le déploiement Vercel se fait
# uniquement via le job CI deploy-web (.github/workflows/ci.yml), qui
# compile et déploie à chaque push sur master. Pour tester en local :
#   flutter build web --release --dart-define=API_BASE_URL=<url backend>/api

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Vercel CLI
.vercel
.env*
